{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/**",
      "excludeFiles": "{node_modules/**,src/**,dist/**,tests/**,scripts/**,agent/**,public/**,backend/data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/ai/:path*", "destination": "/api/index" },
    { "source": "/api/resume/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|data/).*)", "destination": "/index.html" }
  ]
}
