{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,agent/**,src/config/*.json}",
      "excludeFiles": "{node_modules/**,dist/**,tests/**,scripts/**,public/**,backend/data/**,src/**/*.js,src/**/*.jsx,src/**/*.css}"
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/ai/:path*", "destination": "/api/index" },
    { "source": "/api/resume/:path*", "destination": "/api/index" },
    { "source": "/api/jobs/:path*", "destination": "/api/index" },
    { "source": "/api/auth/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|data/).*)", "destination": "/index.html" }
  ]
}
